# Copy this file to `.env.local` (ignored by git) and fill in your EmailJS values.
# Dashboard: https://dashboard.emailjs.com/
#
# These are PUBLIC identifiers — they are embedded in the built JavaScript.
# Never put the EmailJS *private* key (or any secret) in a VITE_ variable.
# Keep real values only in `.env.local` / your hosting provider's settings.
VITE_EMAILJS_SERVICE_ID=null
# Email Templates → your template → "Template ID" (e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=null
# Account → General → "Public Key"
VITE_EMAILJS_PUBLIC_KEY=null
